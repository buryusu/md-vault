# PostgreSQL (use Supabase, Neon, Railway, or Render Postgres)
DATABASE_URL="postgresql://user:password@host:5432/mdvault"

# App URL + a random secret (generate with: openssl rand -base64 32)
NEXTAUTH_URL="https://your-app.onrender.com"
NEXTAUTH_SECRET=""

# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub > Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Comma-separated emails that get admin rights on first login
ADMIN_EMAILS="you@example.com"

# Stripe Dashboard > Developers > API keys / Webhooks
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
